# Copy this file to ".env" to override defaults. Vite only exposes vars prefixed with VITE_.

# Base URL of the backend API. Leave unset for local development
# (defaults to http://localhost:5000).
# For a deployment, set this to your backend's public URL, e.g.:
# VITE_API_URL=https://api.marknex.example.com
# VITE_API_URL=
