# Copy this file to ".env" and fill in real values. Never commit the real .env.

# OpenAI API key used for AI evaluation (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Port the backend server listens on
PORT=5000

# Secret used to sign JWT auth tokens.
# Set this to a long, random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Set to "production" for a live deployment. In production the demo
# teacher/password123 account is NOT auto-created.
NODE_ENV=development

# Allowed CORS origin(s) for the API. Comma-separated for multiple.
# Leave unset to allow all origins (fine for local dev).
# Example: CORS_ORIGIN=https://marknex.example.com
# CORS_ORIGIN=
